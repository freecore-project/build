# HPN/NONECIPHER dropped so we can move to openssh 10.4p1: stock 10.4p1 marks the
# port DEPRECATED with EXPIRATION_DATE=2026-10-01 whenever either is set, and an
# expired port is deleted from the tree.  These backed replication's
# cipher=DISABLED (zettarepl passes the HPN-only -ononeenabled/-ononeswitch), but
# that is unused here -- both replication tasks are transport=LOCAL and there are
# zero SSH keychain credentials -- and AES-NI does aes-128-ctr at 3.78 GB/s/core
# vs 1.25 GB/s for 10GbE, so cipher=FAST already covers the use case.  zettarepl
# probes the flag at runtime and raises a clear error if it is ever selected.
# UNSET explicitly rather than merely removed, so a stale options file cannot
# resurrect them.  See the internal development record.  Operator decision 2026-08-02.
ports += {
    "name": "security/openssh-portable",
    "options": [
        "OPTIONS_FILE_UNSET+=HPN",
        "OPTIONS_FILE_UNSET+=NONECIPHER",
    ]
}
