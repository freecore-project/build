# GPU rendering shared by jails. bhyve PCI passthrough is exclusive to one VM;
# DRM render nodes (/dev/dri/renderD*) are multi-client by design, so a jail
# granted the node through a devfs ruleset renders on the host kernel driver
# alongside every other jail. Not auto-loaded — nothing here touches kld_list
# or the loader, so an image with the module unloaded behaves exactly as before.
# Operators enable it per host through System > Tunables.
#
# The driver is named explicitly rather than via the graphics/drm-kmod metaport,
# and that is deliberate. The metaport carries an UNCONDITIONAL
#   RUN_DEPENDS= gpu-firmware-kmod
# which is itself a metaport pulling 140 firmware packages (amd + radeon +
# intel, ~96 MB of distfiles) — directly against the "no firmware packages"
# decision on the internal development record. drm-66-kmod has no *_DEPENDS at all, and it is exactly
# what the metaport resolves to here: its gate is OSVERSION >= 1500031 on amd64
# and our base is 1501000 (freebsd-src sys/sys/param.h). The specific
# gpu-firmware-amd-kmod-<family> package is a one-line follow-up once a card is
# chosen.
#
# This is the first third-party kernel module in the selected set. It is
# LinuxKPI- and kernel-ABI-coupled: any base sync must rebuild it, and the
# verification that matters is that the built module LOADS on the image kernel,
# not merely that the package exists.
ports += "graphics/drm-66-kmod"

# TrueNAS 13.3 shipped external Aquantia and Realtek drivers. FreeBSD 15 has no
# in-tree Atlantic driver, so retain the port; its pinned version carries the
# required FB15 KPI patches. For Realtek, keep the in-kernel re(4) driver for
# legacy chips and add rge(4) for RTL8125/8126/8127 multi-gigabit adapters.
# Do not also select realtek-re-kmod: it installs another if_re.ko and would
# create an avoidable collision with the driver already built into the kernel.
ports += "net/aquantia-atlantic-kmod"
ports += "net/realtek-rge-kmod"

