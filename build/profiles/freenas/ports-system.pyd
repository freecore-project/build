# curl: pin GSSAPI off.  Upstream (8.21.0+) re-enabled GSSAPI_BASE and made
# the default OS-release conditional:
#   OPTIONS_DEFAULT_15= GSSAPI_${${SSL_DEFAULT} == base :?BASE :NONE}
# config.pyd sets DEFAULT_VERSIONS "ssl=base", so that resolves to
# GSSAPI_BASE and would link base Heimdal into curl -- and into its seven
# dependents (collectd5, syslog-ng, powerman, libvirt, git-lite,
# fusefs-s3fs, apache24).  This appliance does not use GSSAPI, so keep the
# pre-8.21 posture explicitly rather than inheriting whatever upstream
# defaults to next.  Operator decision 2026-08-02.
ports += {
    "name": "ftp/curl",
    "options": [
        "OPTIONS_FILE_SET+=GSSAPI_NONE",
        "OPTIONS_FILE_UNSET+=GSSAPI_BASE",
        "OPTIONS_FILE_UNSET+=GSSAPI_MIT"
    ]
}

ports += {
    "name": "dns/samba-nsupdate",
    "options": ["OPTIONS_FILE_SET+=IPV6"]
}
# Samba 4.19 waf system-library check requires the python bindings
# (pyldb-util.cpython-311, py-tevent), which are built only when these
# transitive deps have their PYTHON option explicitly set in the saved
# options file. Default-on is not enough under poudriere.
ports += {
    "name": "databases/ldb28",
    "options": ["OPTIONS_FILE_SET+=PYTHON3"]
}
ports += {
    "name": "devel/tevent",
    "options": ["OPTIONS_FILE_SET+=PYTHON"]
}
# py-middlewared RUN_DEPENDS pins sqlalchemy14 (13.3-era, preserved in 15.0).
# databases/py-alembic 1.15.2 (2026Q1) added an SQLALCHEMY radio option that
# defaults to SQLALCHEMY20, pulling py-sqlalchemy20 transitively. Both
# sqlalchemy ports declare CONFLICTS_INSTALL against each other and install
# examples to the same /usr/local/share/examples/py311-sqlalchemy dir, so
# simultaneous install into the build jail fails during py-middlewared
# run-depends. Force alembic to the SQLALCHEMY14 variant so both dep paths
# agree on sqlalchemy14.
ports += {
    "name": "databases/py-alembic",
    "options": [
        "OPTIONS_FILE_UNSET+=SQLALCHEMY20",
        "OPTIONS_FILE_SET+=SQLALCHEMY14",
    ]
}
ports += {
    "name": "net/samba424",
    # Samba 4.24.5 rebase (the internal security review, the internal development record + the internal development record);
    # option set carried from the validated samba419 config.
    # Removed 11 nonexistent options from old net/samba config:
    #   ACL_SUPPORT, AIO_SUPPORT, DEBUG, DNSUPDATE, EXP_MODULES,
    #   PAM_SMBPASS, PTHREADPOOL, SPOTLIGHT, NSUPDATE, BIND99, BIND910
    # Added: PROFILE, PYTHON3, GSSAPI_BUILTIN, AVAHI
    # LIBZFS is now hardcoded --with-libzfs in our modified port Makefile.
    # LIBZFS option kept here for compatibility but has no effect.
    # FRUIT (Apple SMB extensions, Time Machine-over-SMB) is default ON and
    # requires mDNS; AVAHI is what TrueNAS 13.3 shipped, preserves the
    # Time Machine advertisement path. Keep MDNSRESPONDER unset so we
    # don't pull a second mDNS stack.
    # CLUSTER off per operator decision 2026-08-16 (the internal development record): FreeCORE
    # ships no HA, so the CTDB surface stops shipping entirely.
    "options": [
        "OPTIONS_FILE_SET+=ADS",
        "OPTIONS_FILE_UNSET+=AD_DC",
        "OPTIONS_FILE_UNSET+=CLUSTER",
        "OPTIONS_FILE_UNSET+=CUPS",
        "OPTIONS_FILE_UNSET+=DEVELOPER",
        "OPTIONS_FILE_SET+=DOCS",
        "OPTIONS_FILE_SET+=FAM",
        "OPTIONS_FILE_SET+=LDAP",
        "OPTIONS_FILE_SET+=LIBZFS",
        "OPTIONS_FILE_SET+=MANPAGES",
        "OPTIONS_FILE_SET+=PROFILE",
        "OPTIONS_FILE_SET+=PYTHON3",
        "OPTIONS_FILE_SET+=QUOTAS",
        "OPTIONS_FILE_SET+=SYSLOG",
        "OPTIONS_FILE_SET+=UTMP",
        "OPTIONS_FILE_SET+=GSSAPI_BUILTIN",
        "OPTIONS_FILE_SET+=AVAHI",
        "OPTIONS_FILE_UNSET+=MDNSRESPONDER",
    ]
}
