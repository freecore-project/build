ports += {
    "name": "net-mgmt/collectd5",
    # NUTUPS re-enabled: middleware's collectd.conf template unconditionally
    # emits LoadPlugin nut on FreeBSD (etc_files/local/collectd.conf:69), and
    # scrapes NUT metrics via <Plugin "nut"> when the UPS service is up.
    # Depends on upsclient.h from sysutils/nut built with DEV (set above).
    # STATGRAB is not a valid option in net-mgmt/collectd5 (not in
    # OPTIONS_GROUP_INPUT); UNSET is a no-op but harmless.
    "options": [
        "OPTIONS_FILE_UNSET+=BIND",
        "OPTIONS_FILE_UNSET+=SNMP",
        "OPTIONS_FILE_SET+=CURL",
        "OPTIONS_FILE_SET+=DEBUG",
        "OPTIONS_FILE_SET+=DISK",
        "OPTIONS_FILE_SET+=NUTUPS",
        "OPTIONS_FILE_SET+=PYTHON",
        "OPTIONS_FILE_SET+=RRDTOOL",
        "OPTIONS_FILE_UNSET+=STATGRAB",
        "OPTIONS_FILE_SET+=XML"
    ]
}

