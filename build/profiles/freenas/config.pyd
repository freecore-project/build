include("repos.pyd")
include("ports.pyd")
include("packages.pyd")

profile = {
    "name": "truenas15",
    "description": "TrueNAS 15",
    "owner": "dev@freecore.org",
    "status": "active"
}

kernel_config = "${PROFILE_ROOT}/kernel/TRUENAS.amd64"

kernel_modules = [
    # Filesystems
    "autofs",
    "ext2fs",
    "fusefs",
    "opensolaris",
    "zfs",
    "smbfs",
    "udf",
    "msdosfs_iconv",
    "libiconv",

    # Storage controllers & NVMe
    "ctl",
    "cfiscsi",
    "iscsi",
    "iser",
    "nvme",
    "nvmf",
    "ioat",
    "hpt27xx",
    "hptmv",
    "hptnr",
    "hptrr",
    "ispfw/ispfw",

    # Networking - core
    "pf",
    "pflog",
    "dummynet",
    "netmap",
    "toecore",
    "libmchain",
    "if_wg",

    # Networking - drivers
    # Keep current in-tree server and cloud NICs available as modules; selecting
    # them here ships the drivers but does not force-load them on every host.
    "bnxt",
    "cxgb",
    "cxgbe",
    "ena",
    "enic",
    "fxp",
    "gve",
    "ice",
    "ice_ddp",
    "igc",
    "mana",
    "mlx5",
    "mlx5en",
    "qlnx",
    "qlxgbe",
    "sis",

    # InfiniBand / RDMA
    "ibcore",
    "ipoib",
    "mlx4ib",
    "mlx5ib",
    "mthca",
    "rdma",
    "irdma",

    # Crypto
    "qat",
    "qatfw",

    # Linuxulator
    "linprocfs",
    "linsysfs",
    "linux",
    "linux64",
    "linux_common",

    # LinuxKPI -- the compatibility layer graphics/drm-66-kmod links against.
    # Distinct from the Linuxulator group above, which is Linux *binary* compat:
    # shipping those does not provide linuxkpi_video, so drm.ko failed to load
    # with "depends on linuxkpi_video - not available" even though the package
    # installed correctly. freecore/the internal development record.
    #
    # linuxkpi_hdmi and linuxkpi_wlan are not referenced by any of the four
    # modules and stay out of the image.
    "linuxkpi",
    "linuxkpi_video",

    # lindebugfs and agp complete drm-66-kmod's dependency closure. The first
    # round of this fix added only linuxkpi/linuxkpi_video because kldxref
    # output was filtered through `grep linuxkpi` and the filtered result was
    # then treated as the whole list -- the image built, and drm.ko still would
    # not load, this time on "depends on lindebugfs". Do not read a dependency
    # list through a grep for the answer you expect.
    #
    # The closure is now computed from source rather than discovered per build:
    # lindebugfs declares MODULE_DEPEND(lindebugfs, linuxkpi) and nothing else;
    # agp declares MODULE_VERSION with no MODULE_DEPEND at all. Everything else
    # the four modules name is either in the kernel (kernel, pci, mem, firmware),
    # already shipped (dmabuf, ttm, iic, iicbb, iicbus), or provided by drm.ko
    # itself (drmn).
    #
    # agp is needed only by i915kms. It is included so the port does not ship a
    # module that cannot load -- the same half-state this issue exists to fix --
    # even though the driving use case is AMD.
    "lindebugfs",
    "agp",

    # Input / HID / evdev
    "evdev",
    "hid",

    # Hardware monitoring / mgmt
    "i2c",
    "ipmi",
    "efirt",
    "hwpmc",

    # Virtualization
    "vmm",
    "nmdm",

    # DTrace / debugging
    "dtrace",

    # TCP congestion control
    "cc",
    "khelp/h_ertt",

    # Security
    "ipsec",
    "mac_ntpd",

    # Misc
    "geom",
    "ntb",
    "nvdimm",
    "usb",
    "smartpqi",
    "mpi3mr",
]

# World/kernel build configuration
make_conf_extra = [
    "CFLAGS += -DNS_REREAD_CONF",
]

make_conf_build = {
    "WITHOUT_BLUETOOTH":            "yes",
    "WITHOUT_BSDINSTALL":           "yes",
    "WITHOUT_BSNMP":                "yes",
    "WITHOUT_CALENDAR":             "yes",
    "WITHOUT_CUSE":                 "yes",
    "WITHOUT_DICT":                 "yes",
    "WITHOUT_FREEBSD_UPDATE":       "yes",
    "WITHOUT_GAMES":                "yes",
    "WITHOUT_GCOV":                 "yes",
    "WITHOUT_HTML":                 "yes",
    "WITHOUT_IPFILTER":             "yes",
    "WITHOUT_LIB32":                "yes",
    "WITHOUT_LPR":                  "yes",
    "WITHOUT_NLS":                  "yes",
    "WITHOUT_PPP":                  "yes",
    "WITHOUT_SENDMAIL":             "yes",
    "WITHOUT_SOUND":                "yes",
    "WITHOUT_SYSCONS":              "yes",
    "WITHOUT_WIRELESS":             "yes",
    "WITHOUT_WPA_SUPPLICANT_EAPOL": "yes",
    "LOCAL_DIRS":                   "libexec/phttpget share/examples/ses tools/tools/cxgbtool tools/tools/cxgbetool"
}

# Packages build jail configuration
make_conf_jail = {
    "WITHOUT_DEBUG_FILES":          "yes",
}

# Packages configuration
make_conf_pkg = {
    "DEFAULT_VERSIONS":             "python=3.11 python3=3.11 ssl=base",
    "WITH_SAMBA4_PYTHON3":          "python3.11",
    "OPTIONS_UNSET":                "DOCS X11 JAVA",
    "WANT_OPENLDAP_SASL":           "yes",
    "USE_PACKAGE_DEPENDS":          "yes",
    "BATCH":                        "yes",
    "WRKDIRPREFIX":                 "/wrkdirs",
    "DISABLE_LICENSES":             "yes",
    "DEBUG_FLAGS":                  "-g",
    "CFLAGS":                       "+= -g",
    "STRIP":                        "",
    "MAKE_ENV":                     "+= DONTSTRIP=yes",
    "STRIP_CMD":                    "true"
}

# Configuration for installed NAS
make_conf_run = {
}

# Configuration for installer
make_conf_boot = {
    "WITHOUT_BHYVE":                "yes",
    "WITHOUT_CALENDAR":             "yes",
    "WITHOUT_DEBUG_FILES":          "yes",
    "WITHOUT_DICT":                 "yes",
    "WITHOUT_EXAMPLES":             "yes",
    "WITHOUT_ICONV":                "yes",
    "WITHOUT_INETD":                "yes",
    "WITHOUT_JAIL":                 "yes",
    "WITHOUT_KDUMP":                "yes",
    "WITHOUT_KERNEL_SYMBOLS":       "yes",
    "WITHOUT_LOCALES":              "yes",
    "WITHOUT_LPR":                  "yes",
    "WITHOUT_MAIL":                 "yes",
    "WITHOUT_NIS":                  "yes",
    "WITHOUT_NLS":                  "yes",
    "WITHOUT_PMC":                  "yes",
    # WITHOUT_ZFS removed for FB15: on 13.x the installer got zpool/zfs from
    # the `sysutils/openzfs` port (installed via ports-installer.pyd). That
    # port was dropped for FB15 because OpenZFS 2.4 ships in-base. Leaving
    # WITHOUT_ZFS=yes AND removing the port leaves the installer with no
    # zpool/zfs anywhere — /etc/install.sh fails at the first `zpool create`
    # with "zpool: not found".
}

early_customize_tasks = [
    "write-version"
]

# If not doing a SDK build
if SDK == "no":
    temp_dict = {
        "WITHOUT_CLANG_FULL":           "yes",
        "WITHOUT_PROFILE":              "yes",
        "WITHOUT_TESTS":                "yes",
    }
    make_conf_build.update(temp_dict)
    temp_dict = {
        "WITHOUT_TOOLCHAIN":            "yes",
        "WITHOUT_INSTALLLIB":           "yes",
    }
    make_conf_run.update(temp_dict)
    temp_dict = {
         "WITHOUT_MAKE":                 "yes",
         "WITHOUT_MAN":                  "yes",
         "WITHOUT_PROFILE":              "yes",
    }
    make_conf_boot.update(temp_dict)
    customize_tasks = [
         "remove-bits",
         "remove-var-cache-pkg",
         "remove-non-amd64",
         "conf-base",
         "link-bash",
         "login-conf",
         "install-avatar-conf"
    ]
else:
    customize_tasks = [
         "remove-var-cache-pkg",
         "conf-base",
         "link-bash",
         "login-conf",
         "install-avatar-conf"
    ]
